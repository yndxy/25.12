--- /dev/null
+++ b/package/base-files/files/etc/uci-defaults/99-aigo-wan
@@ -0,0 +1,22 @@
+#!/bin/sh
+# Aigo AGS21: enable gmac1 as the WAN interface (eth1)
+[ "$(board_name)" = "aigo,ags21" ] || exit 0
+
+i=0
+while [ ! -d /sys/class/net/eth1 ] && [ "$i" -lt 30 ]; do
+	sleep 1
+	i=$((i + 1))
+done
+
+[ -d /sys/class/net/eth1 ] || exit 0
+
+uci set network.wan=interface
+uci set network.wan.proto='dhcp'
+uci set network.wan.device='eth1'
+uci set network.wan.ipv6='auto'
+uci set network.lan.ip6assign='60'
+uci commit network
+
+[ -f /etc/board.json ] && sed -i -e 's/"device": "wan"/"device": "eth1"/' -e 's/"lan2",/"lan2"/' -e '/"lan3"/d' -e '/"lan4"/d' /etc/board.json
+
+exit 0
